---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import IssueCard from '../components/IssueCard.astro';
import { categories } from '../data/categories';
import { sitePath } from '../lib/url';

const issues = (await getCollection('issues')).sort(
  (a, b) => b.data.last_reviewed.getTime() - a.data.last_reviewed.getTime(),
);
const featuredIssues = issues;
const issuesByCategory = (title: string) =>
  issues
    .filter((issue) => issue.data.category === title)
    .sort((a, b) => a.data.title.localeCompare(b.data.title, 'ja'));
---

<BaseLayout>
  <section class="hero">
    <div>
      <p class="eyebrow">Public agenda for structural renewal</p>
      <h1>日本が先送りせず解くべき課題</h1>
      <p class="lead">
        社会・政府・企業が向き合うべき構造課題を、出典つきの課題カードとして整理し、GitHub上で継続更新していくためのサイトです。
      </p>
    </div>
    <aside class="callout">
      <strong>このサイトの基本姿勢</strong>
      <p>事実・解釈・提案を分ける。先送りコストを可視化する。政府・企業・自治体・個人の行動に接続する。</p>
      <p><a href={sitePath('/issues')}>課題一覧を見る</a></p>
    </aside>
  </section>

  <section>
    <h2>8つの社会システム</h2>
    <div class="grid">
      {categories.map((category) => (
        <CategoryCard {...category} issues={issuesByCategory(category.title)} />
      ))}
    </div>
  </section>

  <section>
    <h2>すべての課題カード（最新更新順）</h2>
    <div class="grid">
      {featuredIssues.map((issue) => <IssueCard issue={issue} />)}
    </div>
  </section>
</BaseLayout>
