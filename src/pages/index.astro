---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import IssueCard from '../components/IssueCard.astro';
import { categories } from '../data/categories';
import { sitePath } from '../lib/url';

const issues = (await getCollection('issues')).sort(
  (a, b) => b.data.last_reviewed.getTime() - a.data.last_reviewed.getTime(),
);
const featuredIssues = issues;
const issuesByCategory = (title: string) =>
  issues
    .filter((issue) => issue.data.category === title)
    .sort((a, b) => a.data.title.localeCompare(b.data.title, 'ja'));
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">出典つきの公共アジェンダ</p>
    <h1>先送りせず、いま解くべき課題。</h1>
    <p class="lead">
      日本の社会・政府・企業が向き合うべき構造課題を、出典つきの課題カードとして継続的に整理します。
    </p>
    <p><a class="cta" href={sitePath('/issues')}>課題一覧を見る →</a></p>
  </section>

  <section>
    <h2>8つの社会システム</h2>
    <div class="grid">
      {categories.map((category) => (
        <CategoryCard {...category} issues={issuesByCategory(category.title)} />
      ))}
    </div>
  </section>

  <section>
    <h2>すべての課題カード（最新更新順）</h2>
    <div class="grid">
      {featuredIssues.map((issue) => <IssueCard issue={issue} />)}
    </div>
  </section>
</BaseLayout>
