---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import IssueCard from '../components/IssueCard.astro';
import RegulationList from '../components/RegulationList.astro';
import { categories } from '../data/categories';
import { sitePath } from '../lib/url';

const issues = (await getCollection('issues')).sort(
  (a, b) => b.data.last_reviewed.getTime() - a.data.last_reviewed.getTime(),
);
const featuredIssues = issues;
const issueTitles = Object.fromEntries(issues.map((i) => [i.id, i.data.title]));
// 既定は「重要度（緊急度×深刻度）」降順。同点は深刻度→緊急度→タイトルで安定化。
// JS なしでもこの順で並ぶ（ボタンはプログレッシブ・エンハンスメント）。
const score = (i: { data: { urgency: number; severity: number } }) =>
  i.data.urgency * i.data.severity;
const issuesByCategory = (title: string) =>
  issues
    .filter((issue) => issue.data.category === title)
    .sort(
      (a, b) =>
        score(b) - score(a) ||
        b.data.severity - a.data.severity ||
        b.data.urgency - a.data.urgency ||
        a.data.title.localeCompare(b.data.title, 'ja'),
    );
---

<BaseLayout>
  <section class="hero">
    <h1 class="lead">
      個別の事件や一時的な話題ではなく、放置すれば国全体で社会の維持が揺らぐ——いま向き合うべき構造的な問題を、AIが分野を横断して抽出・整理しました。
    </h1>
    <p><a class="cta" href={sitePath('/issues')}>課題一覧を見る →</a></p>
    <p class="hero-note">
      ※ 本サイトは AI による自動コーディングの評価版です。SNS での言及やご指摘などに応じて、内容を随時更新していきます。
    </p>
  </section>

  <section class="cat-section">
    <div class="section-head">
      <h2>{categories.length}つの社会システム</h2>
      <div class="sort-control" role="group" aria-label="各分類内の課題の並び替え">
        <span class="sort-label">並び替え</span>
        <button type="button" class="sort-btn is-active" data-sort="total" aria-pressed="true">重要度</button>
        <button type="button" class="sort-btn" data-sort="urgency" aria-pressed="false">緊急度</button>
        <button type="button" class="sort-btn" data-sort="severity" aria-pressed="false">深刻度</button>
      </div>
    </div>
    <div class="grid">
      {categories.map((category) => (
        <CategoryCard {...category} issues={issuesByCategory(category.title)} />
      ))}
    </div>
  </section>

  <script>
    // 分類カード内の課題リストを、緊急度/深刻度/重要度(積)で再ソート（クライアント側）。
    document.querySelectorAll<HTMLElement>('.cat-section').forEach((section) => {
      const lists = Array.from(section.querySelectorAll<HTMLUListElement>('.category-issues'));
      const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>('.sort-btn'));
      const num = (el: Element, key: string) => Number(el.getAttribute(key) || 0);
      const keyOf = (li: Element, mode: string) =>
        mode === 'urgency'
          ? num(li, 'data-urgency')
          : mode === 'severity'
            ? num(li, 'data-severity')
            : num(li, 'data-urgency') * num(li, 'data-severity');

      const sortAll = (mode: string) => {
        for (const ul of lists) {
          const items = Array.from(ul.children) as HTMLElement[];
          items
            .sort(
              (a, b) =>
                keyOf(b, mode) - keyOf(a, mode) ||
                num(b, 'data-severity') - num(a, 'data-severity') ||
                num(b, 'data-urgency') - num(a, 'data-urgency') ||
                (a.getAttribute('data-title') || '').localeCompare(
                  b.getAttribute('data-title') || '',
                  'ja',
                ),
            )
            .forEach((li) => ul.appendChild(li));
        }
      };

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.getAttribute('data-sort') || 'total';
          buttons.forEach((b) => {
            const on = b === btn;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-pressed', String(on));
          });
          sortAll(mode);
        });
      });
    });
  </script>

  <section class="reg-section">
    <div class="section-head">
      <h2>構造改革で論点となる規制・法律</h2>
    </div>
    <p class="lead reg-lead">
      上記の構造課題の背景で、改革の是非が議論されている主な規制・法律を、分類ごとに公式出典つきで中立に整理した索引です。各項目は関連する課題カードにつないでいます。詳しい論点は課題カード側をご覧ください。
    </p>
    <RegulationList issueTitles={issueTitles} />
  </section>

  <section>
    <h2>すべての課題カード（最新更新順）</h2>
    <div class="grid">
      {featuredIssues.map((issue) => <IssueCard issue={issue} />)}
    </div>
  </section>
</BaseLayout>
