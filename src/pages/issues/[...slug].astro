---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceBox from '../../components/EvidenceBox.astro';
import Rating from '../../components/Rating.astro';
import { sitePath } from '../../lib/url';

export async function getStaticPaths() {
  const issues = await getCollection('issues');
  return issues.map((issue) => ({
    params: { slug: issue.id },
    props: { issue },
  }));
}

const { issue } = Astro.props;
const d = issue.data;
const { Content } = await render(issue);

// 関連課題は id → タイトルに解決して表示（未知のidはスキップ）
const allIssues = await getCollection('issues');
const titleById = new Map(allIssues.map((i) => [i.id, i.data.title]));
const related = d.related
  .filter((id) => titleById.has(id))
  .map((id) => ({ id, title: titleById.get(id) }));

const fmtDate = (date: Date) => date.toISOString().slice(0, 10);

const pageUrl = Astro.site
  ? new URL(sitePath(`/issues/${issue.id}`), Astro.site).href
  : sitePath(`/issues/${issue.id}`);
const ps = d.policy_summary;
const psRows: [string, string][] = ps
  ? ([
      ['いま何が問題か', ps.now],
      ['なぜ今か', ps.why_now],
      ['最大の制約', ps.constraint],
      ['政策レバー', ps.levers && ps.levers.length ? ps.levers.join('、') : undefined],
      ['最重要KPI', ps.kpi],
      ['政治的争点', ps.contention],
    ].filter((row): row is [string, string] => Boolean(row[1])))
  : [];
const citation = `japan-todo「${d.title}」最終確認 ${fmtDate(d.last_reviewed)}, ${pageUrl}`;
---

<BaseLayout title={d.title} description={d.description}>
  <article class="issue-body">
    <p class="eyebrow">{d.category} / {d.subcategory}</p>
    <h1>{d.title}</h1>
    <p class="lead">{d.description}</p>
    <div class="meta ratings">
      <Rating label="緊急度" value={d.urgency} variant="urgency" />
      <Rating label="深刻度" value={d.severity} variant="severity" />
    </div>
    <div class="meta">
      <span class="badge">最終確認: {fmtDate(d.last_reviewed)}</span>
      {d.actors.map((actor) => <span class="badge">{actor}</span>)}
      {d.capital.map((capital) => <span class="badge">{capital}</span>)}
    </div>

    {/* Layer 1: すぐ読む概要 */}
    {(d.essence || d.summary.length > 0) && (
      <section class="summary-box" aria-label="要約">
        {d.essence && <p class="essence">{d.essence}</p>}
        {d.summary.length > 0 && (
          <>
            <h2>30秒要約</h2>
            <ul>
              {d.summary.map((point) => <li>{point}</li>)}
            </ul>
          </>
        )}
      </section>
    )}

    {/* Layer 1: 政策判断サマリー（意思決定者向け6項目） */}
    {psRows.length > 0 && (
      <section class="policy-summary" aria-label="政策判断サマリー">
        <strong>政策判断サマリー</strong>
        <dl>
          {psRows.map(([k, v]) => (
            <div class="ps-row">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {/* Layer 2: 標準本文 */}
    <div class="issue-content">
      <Content />
    </div>

    {/* Layer 3: 詳細・根拠（折りたたみ） */}
    <details class="detail-layer">
      <summary>詳細・根拠を見る（出典・関連課題・更新履歴）</summary>
      <EvidenceBox sources={d.sources} />
      {related.length > 0 && (
        <section class="related" aria-label="関連課題">
          <h2>関連課題</h2>
          <ul>
            {related.map((r) => (
              <li><a href={sitePath(`/issues/${r.id}`)}>{r.title}</a></li>
            ))}
          </ul>
        </section>
      )}
      <section class="update-log" aria-label="更新履歴">
        <h2>更新履歴</h2>
        <p>
          最終確認日: {fmtDate(d.last_reviewed)}
          {d.next_review && <> ／ 次回確認予定: {d.next_review}</>}
        </p>
      </section>
      <section class="cite-box" aria-label="このページを引用">
        <h2>このページを引用</h2>
        <p class="cite-text">{citation}</p>
      </section>
    </details>
  </article>
</BaseLayout>
