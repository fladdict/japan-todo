---
import type { CollectionEntry } from 'astro:content';
import { sitePath } from '../lib/url';
import Rating from './Rating.astro';

interface Props {
  issue: CollectionEntry<'issues'>;
}
const { issue } = Astro.props;
const isCritical = issue.data.urgency * issue.data.severity >= 15;
---

<article class="card">
  <div class="meta ratings">
    <Rating label="緊急度" value={issue.data.urgency} variant="urgency" />
    <Rating label="深刻度" value={issue.data.severity} variant="severity" />
  </div>
  <h3><a class={isCritical ? 'title-critical' : undefined} href={sitePath(`/issues/${issue.id}`)}>{issue.data.title}</a></h3>
  <p>{issue.data.description}</p>
  <div class="meta" aria-label="Tags">
    <span class="badge">{issue.data.category}</span>
    {issue.data.time_horizon.map((tag) => <span class="badge">{tag}</span>)}
  </div>
</article>
