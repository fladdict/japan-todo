---
import type { CollectionEntry } from 'astro:content';
import { sitePath } from '../lib/url';

interface Props {
  id: string;
  title: string;
  description: string;
  issues?: CollectionEntry<'issues'>[];
}
const { id, title, description, issues = [] } = Astro.props;
---

<article class="card category-card">
  <h3>
    <a href={sitePath(`/categories/${id}`)}>{title}</a>
    <span class="category-count">{issues.length}件</span>
  </h3>
  <p>{description}</p>
  {issues.length > 0 ? (
    <ul class="category-issues">
      {issues.map((issue) => (
        <li>
          <a href={sitePath(`/issues/${issue.id}`)}>{issue.data.title}</a>
          <span class="mini-rating" aria-label={`緊急度${issue.data.urgency}・深刻度${issue.data.severity}（各5段階）`}>
            緊{issue.data.urgency}・深{issue.data.severity}
          </span>
        </li>
      ))}
    </ul>
  ) : (
    <p class="category-empty">課題カードは準備中です。</p>
  )}
</article>
