---
import '../styles/global.css';
import { sitePath } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '日本が先送りせず解くべき課題',
  description = '日本の社会・政府・企業が先送りせず解くべき構造課題を、継続更新できる課題カードとして整理する公共メモリ。',
} = Astro.props;
const pageTitle = title === '日本が先送りせず解くべき課題' ? title : `${title} | 日本が先送りせず解くべき課題`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={sitePath('/')}>日本が先送りせず解くべき課題</a>
      <!-- ナビ: PC はインライン常時表示。モバイルはトグルで開閉（aria-expanded をJSで切替、CSSで表示制御）。 -->
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="メニューを開閉"
      >
        <span class="nav-toggle-icon" aria-hidden="true"></span>
        <span>メニュー</span>
      </button>
      <nav id="site-nav" aria-label="Main navigation">
        <a href={sitePath('/')}>ホーム</a>
        <a href={sitePath('/issues')}>課題一覧</a>
        <a href={sitePath('/regulations')}>規制・法律</a>
        <a href={sitePath('/map')}>課題マップ</a>
        <a href={sitePath('/sources')}>出典・データ</a>
        <a href={sitePath('/about')}>このサイトについて</a>
      </nav>
    </header>
    <script>
      // モバイルのナビ開閉（プログレッシブ・エンハンスメント）。PC では CSS でトグルを隠しナビを常時表示。
      const header = document.querySelector('.site-header');
      const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
      if (header && toggle) {
        const setOpen = (open: boolean) => toggle.setAttribute('aria-expanded', String(open));
        toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
        document.addEventListener('click', (e) => {
          if (!header.contains(e.target as Node)) setOpen(false);
        });
      }
    </script>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>事実・解釈・提案を分け、出典と更新履歴を残しながら育てるオープンな課題地図です。</p>
      <p class="footer-links">
        <a href={sitePath('/map')}>課題マップ</a>・<a href={sitePath('/tags')}>タグ一覧</a>・<a href={sitePath('/sources')}>出典・データ集</a>
      </p>
    </footer>
  </body>
</html>
