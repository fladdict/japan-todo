---
import '../styles/global.css';
import { sitePath } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '日本が先送りせず解くべき課題',
  description = '日本の社会・政府・企業が先送りせず解くべき構造課題を、継続更新できる課題カードとして整理する公共メモリ。',
} = Astro.props;
const pageTitle = title === '日本が先送りせず解くべき課題' ? title : `${title} | 日本が先送りせず解くべき課題`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={sitePath('/')}>日本が先送りせず解くべき課題</a>
      <!-- ナビ: PC はインライン常時表示。モバイルはトグルで開閉（aria-expanded をJSで切替、CSSで表示制御）。 -->
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="メニューを開閉"
      >
        <span class="nav-toggle-icon" aria-hidden="true"></span>
        <span>メニュー</span>
      </button>
      <nav id="site-nav" aria-label="Main navigation">
        <a href={sitePath('/')}>ホーム</a>
        <a href={sitePath('/issues')}>課題一覧</a>
        <a href={sitePath('/regulations')}>規制・法律</a>
        <a href={sitePath('/map')}>課題マップ</a>
        <a href={sitePath('/sources')}>出典・データ</a>
        <a href={sitePath('/about')}>このサイトについて</a>
      </nav>
    </header>
    <script>
      // モバイルのナビ開閉（プログレッシブ・エンハンスメント）。PC では CSS でトグルを隠しナビを常時表示。
      const header = document.querySelector('.site-header');
      const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
      if (header && toggle) {
        const setOpen = (open: boolean) => toggle.setAttribute('aria-expanded', String(open));
        toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
        document.addEventListener('click', (e) => {
          if (!header.contains(e.target as Node)) setOpen(false);
        });
      }
    </script>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>事実・解釈・提案を分け、出典と更新履歴を残しながら育てるオープンな課題地図です。</p>

      <section class="footer-disclaimer" aria-label="このサイトについての注意書き">
        <p class="footer-disc-title">このサイトについて（ディスクレーマー）</p>
        <ul>
          <li>
            <strong>生成AIによる制作・評価版です。</strong>本文・図・サイトのコードは生成AIが作成し、人手で点検しています。誤りや古い情報を含む可能性があるため、重要な判断は各ページの一次出典に当たってご確認ください。気づいた点や事実誤認のご指摘（SNS等）を歓迎し、内容は随時更新します。
          </li>
          <li>
            <strong>特定の政党・政治的立場（右派／左派）はとりません。</strong>「社会の持続可能性と生活の質（QOL）を、長期にわたって維持・向上できるか」を最優先の判断軸として課題を選び、緊急度と深刻度で優先度を示しています。賛否が分かれる論点は結論を断定せず、対立軸と出典を併記します。
          </li>
          <li>
            <strong>中立を志向しますが、完全な無偏りを保証するものではありません。</strong>課題の選び方や表現に偏りが残ることがあります。事実・解釈・提案を分け、トレードオフや反対論も併記するよう努めています（編集方針は<a href={sitePath('/about')}>このサイトについて</a>）。
          </li>
        </ul>
      </section>

      <p class="footer-links">
        <a href={sitePath('/map')}>課題マップ</a>・<a href={sitePath('/tags')}>タグ一覧</a>・<a href={sitePath('/sources')}>出典・データ集</a>・<a href={sitePath('/about')}>このサイトについて</a>
      </p>
    </footer>
  </body>
</html>
